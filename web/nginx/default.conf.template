events {
  worker_connections 1024;
}

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;

  sendfile on;
  keepalive_timeout 65;

  server {
    listen 80;

    # Serve static React files
    location / {
      root /usr/share/nginx/html;
      try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to the Express.js server
    location /api/ {
      # Keep using the variable for dynamic resolution (this is good!)
      # Railway: http://inc-attendance-monitor-express-server.railway.internal:3001
      # NGROK: http://express-server:3001
      #proxy_pass http://${EXPRESS_SERVER_HOST_PORT};
      proxy_pass http://express-server:3001;

      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_redirect off;

      # Timeouts for the proxy connection (these values might be too high, consider reducing if not needed)
      proxy_connect_timeout 600s;
      proxy_send_timeout 600s;
      proxy_read_timeout 600s;
    }

    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
      root   /usr/share/nginx/html;
    }
  }
}